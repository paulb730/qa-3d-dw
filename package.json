{
  "name": "qa-3d-dw",
  "version": "1.0.0",
  "private": true,
  "description": "QA Immersive 3D DataWarehouse - Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx --no-warnings src/index.ts",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "clean": "turbo run clean && rm -rf node_modules",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "turbo": "^2.3.0",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.0.0"
}