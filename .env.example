# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
# Formato: postgresql://[user]:[password]@[host]:[port]/[dbname]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qa_3d_dw

# ==========================================
# CACHE & MESSAGE BROKER (Redis)
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# PORTS (Para desarrollo local)
# ==========================================
PORT_DATA_SERVICE=3002
PORT_QA_SERVICE=3001
PORT_SCENE_SERVICE=3003

# ==========================================
# FRONTEND (Vite requiere prefijo VITE_)
# ==========================================
# URLs de los servicios para que el frontend sepa a dónde conectar
VITE_DATA_SERVICE_URL=http://localhost:3002
VITE_QA_SERVICE_URL=http://localhost:3001
VITE_SCENE_SERVICE_URL=http://localhost:3003

# ==========================================
# NODE ENV
# ==========================================
NODE_ENV=development
