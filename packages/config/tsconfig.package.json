{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Shared Package Configuration",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "emitDeclarationOnly": false
  }
}
